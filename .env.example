# Inside Your Brain: copy this file to .env and fill in what you need.
# Everything works without a key: you get the 8 hand-written replays, the explorer and the lab.

# --- AI (optional) ---
GEMINI_API_KEY=
# Model that writes replays (structured JSON).
MODEL_REPLAY=gemini-3.8-flash
# Model that answers questions in the Ask drawer.
MODEL_ASK=gemini-3.8-flash
# Demo mode: canned answers, no API calls. Handy for working on the UI without a key.
MOCK_AI=false

# --- Server ---
PORT=8787
# Only needed if the site and the API are on different domains (comma-separated).
ALLOWED_ORIGIN=
# Set to 1 behind a reverse proxy or load balancer so rate limits see the real visitor IP.
TRUST_PROXY=false

# --- Limits ---
RATE_LIMIT_PER_MIN=20
MAX_INPUT_CHARS=600
MAX_TURNS=12
MAX_OUTPUT_TOKENS=700

# --- Build time (reaches the browser, so never put secrets here) ---
VITE_AI_ENABLED=true
