# Inside the Brain — Environment Configuration
# Copy this file to .env and fill in the values.

# AI Features (optional — everything works without these)
ANTHROPIC_API_KEY=
MODEL_TUTOR=claude-sonnet-4-20250514
MODEL_FAST=claude-haiku-4-20250414

# Server
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Rate Limiting
RATE_LIMIT_PER_MIN=20
MAX_INPUT_CHARS=1000
MAX_TURNS=12
MAX_OUTPUT_TOKENS=800

# Build-time (prefix with VITE_ to reach the client)
VITE_AI_ENABLED=true
