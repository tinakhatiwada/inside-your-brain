{
  "name": "inside-the-brain",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive, AI-assisted neuroscience learning platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
