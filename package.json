{
  "name": "inside-your-brain",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Replay everyday moments through a 3D brain, explained in plain language.",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,yellow \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "npm run build && npm start",
    "content:validate": "node scripts/validate-content.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "express": "^5.3.0",
    "three": "^0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vite": "^6.4.5"
  }
}
